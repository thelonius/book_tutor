# Достаточно одного из двух ключей: llm.py соберёт цепочку из доступного.

# Zhipu напрямую — glm-4.7-flash и glm-4.5-flash бесплатны, квота своя.
# https://z.ai
ZHIPU_API_KEY=

# OpenRouter — nemotron и gemma по free-моделям, квота общая на всех.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Необязательное
# APP_URL=http://localhost:5003/
# LIBRARY_DB_PATH=data/library.db
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# VECTOR_FLOOR=0.45
